// Cloudflare Workers static-assets deploy: no Worker script, just the Vite
// build output. `name` must match the Worker in the Cloudflare dashboard.
// SPA mode serves index.html for unknown paths, so deep links like /results
// survive a refresh.
{
  "name": "lukutaju",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
